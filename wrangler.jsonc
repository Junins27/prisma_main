{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prisma",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/tema/*", "/projetos/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
